# ==============================================================================
# Backend Environment Configuration Template (.env.example)
# ==============================================================================

# Application Runtime
NODE_ENV=development
PORT=5000

# Database Configuration (MongoDB)
MONGO_URI=mongodb://127.0.0.1:27017/rbac_collaboration

# Security & Authentication Secrets
JWT_SECRET=replace_with_a_secure_random_jwt_secret_key
JWT_EXPIRES_IN=7d
COOKIE_SECRET=replace_with_a_secure_random_cookie_secret_key

# CORS & Client Integration
CLIENT_URL=http://localhost:5173

# Rate Limiting Configuration
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=1000

# Audit & Logging
LOG_LEVEL=info
