# ==============================================================================
# Frontend Environment Configuration Template (.env.example)
# ==============================================================================

# API Base URL (Proxy route or full backend URL)
VITE_API_BASE_URL=/api

# Application Branding
VITE_APP_NAME=OmniRBAC
VITE_APP_DESCRIPTION="Enterprise Multi-Organization Collaboration Platform"

# Features & Feature Flags
VITE_ENABLE_AUDIT_STREAM=true
VITE_ENABLE_ANALYTICS=false
